{
  // markdownlint config for better-toolkits.
  // This repo is documentation-heavy (protocols, specs, conventions, skills)
  // with wide tables, long URLs, shell commands, and YAML frontmatter
  // descriptions that legitimately exceed any line-length limit. Rules below
  // are relaxed or kept deliberately; each has a stated reason.
  //
  // MD013 — line length. Disabled: docs carry long URLs, commands, and
  // skill frontmatter `description:` lines that cannot be split without
  // breaking their content. Enforcing a wrap here would be noise, not quality.
  "MD013": false,
  //
  // MD024 — duplicate headings. Disabled: README/docs intentionally repeat
  // sub-sections (e.g. "Install", "What you get", "License") under each
  // toolkit/component, at the same nesting depth. `allow_different_nesting`
  // does not cover same-depth siblings, so this rule is not a fit.
  "MD024": false,
  //
  // MD004 — unordered list style: dash is the repo convention.
  "MD004": {
    "style": "dash"
  },
  // Emphasis used as a pseudo-heading is a stylistic choice in callouts.
  "MD036": false,
  // Documents do not all start with a top-level H1 (some are fragments).
  "MD041": false,
  // Table pipe-style alignment is cosmetic; not gating.
  "MD060": false,
  // Redundant reference-link syntax is tolerated.
  "MD034": false
}
