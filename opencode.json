{
  "mcp": {
    "servers": {
      "google-workspace-apps": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "tsx",
          "shared/mcp/google-workspace-apps/google-for-rclone.ts"
        ]
      },
      "social-media-ads-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "tsx",
          "shared/mcp/social-media-ads-mcp/src/server.ts"
        ]
      },
      "notion-chimeranext": {
        "type": "local",
        "command": [
          "node",
          "shared/mcp/notion-chimeranext/server.js"
        ],
        "environment": {
          "NOTION_API_KEY": "{env:NOTION_API_KEY}"
        }
      },
      "posthog-chimeranext": {
        "type": "local",
        "command": [
          "node",
          "shared/mcp/posthog-chimeranext/server.js"
        ],
        "environment": {
          "POSTHOG_HOST": "{env:POSTHOG_HOST}",
          "POSTHOG_PERSONAL_API_KEY": "{env:POSTHOG_PERSONAL_API_KEY}",
          "POSTHOG_PROJECT_ID": "{env:POSTHOG_PROJECT_ID}"
        },
        "protocol": "2026-07-28"
      },
      "linear-chimeranext": {
        "type": "local",
        "command": [
          "node",
          "shared/mcp/linear-chimeranext/server.js"
        ],
        "environment": {
          "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
        }
      },
      "stitch-chimeranext": {
        "type": "local",
        "command": [
          "node",
          "shared/mcp/stitch-chimeranext/server.js"
        ],
        "environment": {
          "STITCH_GCP_PROJECT": "{env:STITCH_GCP_PROJECT}",
          "STITCH_PROJECT_ID": "{env:STITCH_PROJECT_ID}"
        }
      },
      "slack-chimeranext": {
        "type": "local",
        "command": [
          "node",
          "shared/mcp/slack-chimeranext/server.js"
        ],
        "environment": {
          "SLACK_BOT_TOKEN": "{env:SLACK_BOT_TOKEN}"
        }
      }
    }
  }
}
