{
  "description": "make-no-mistakes \u2014 manifest-driven PreToolUse + PostToolUse + Stop hooks. Generic regex rules live in hooks/rules/rules.yaml (compiled to rules.json). Per-repo atomic-design enforcement lives in hooks/atomic/ and reads .atomic-design-rules.json at the consumer repo root (no-op if absent). Cross-cutting Cure 4b hooks live in hooks/cross-cutting/ and read .claude/config/cross-cutting-hooks.json (no-op if absent). Opt-in Linear create-hygiene lives in hooks/hygiene/ via .claude/config/hygiene-hooks.json \u2014 see /hygiene-hooks-setup. Stderr preserve is ON by default (opt-out via .claude/config/stderr-hooks.json or MNM_DISABLE_STDERR_HOOK=1) \u2014 see hooks/stderr/README.md. Prod-write (hooks/qa/) and observability (hooks/observability/) no-op until their contract JSON exists in the consumer repo. stop-prs-green no-ops unless .claude/.implement-prs exists.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/stderr/adapters/claude-pre-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/pre-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/atomic/pre-atomic.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/cross-cutting/pre-write-no-cleartext-secret-in-config.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/cross-cutting/pre-write-cross-repo-schema-ownership.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/cross-cutting/pre-write-version-bump-discipline.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/observability/pre-write-observability-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*linear.*__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/hygiene/pre-linear-save-issue-hygiene.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*(click|fill|form_input|type_text|browser_type|press_key|select_option|drag|drop|upload|file_upload|handle_dialog|evaluate|javascript_tool|shortcuts_execute|computer|run_code)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/qa/pre-tool-prod-write-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude_ai_Slack__slack_send_message|mcp__claude_ai_Slack__slack_send_message_draft",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-slack.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/atomic/post-atomic-drift.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__.*linear.*__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/hygiene/post-linear-save-issue-state-landed.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/hygiene/stop-prs-green.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
