# Generated by /assurance-setup.
# Detecta merges a main que pasaron por encima del check (bypass) y persiste
# un receipt en el repo interno internal-audits. Evidencia, no gate de merge.
name: bypass audit

on:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
      - name: Audit bypasses
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          AUDIT_GIT_TOKEN: ${{ secrets.AUDIT_GIT_TOKEN }}
          AUDIT_REPO: __AUDIT_REPO__
        run: bash scripts/ci/audit-bypass.sh
