# Generated by /assurance-setup.
# Lecciones: sin filtros paths (check siempre presente); evidencia como artifact
# (no depende de GHAS/code scanning); codeql v3 deprecado.
name: megalinter

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  megalinter:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: oxsecurity/megalinter@v10
        env:
          VALIDATE_ALL_CODEBASE: "false" # PR: solo diff; push main: todo
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      # Evidencia sin GHAS: artifact. (Opcional, solo con GHAS: codeql v4.)
      - name: Upload MegaLinter reports (SARIF/JSON/MD)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: megalinter-reports
          path: megalinter-reports/
