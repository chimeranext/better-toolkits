---
# Generated by /assurance-setup. SSOT: references/assurance-setup/protocol.md
# Lecciones: typecheck como PRE_COMMAND con --include=dev; artifacts, no GHAS.
APPLY_FIXES: none            # determinismo: sin auto-fix en CI
PRINT_ALPACA: true
SHOW_ELAPSED_TIME: true
GITHUB_STATUS_REPORTER: false
JSON_REPORTER: true
SARIF_REPORTER: true          # evidencia SARIF -> receipts
EMAIL_REPORTER: false
FLAVOR_SUGGESTIONS: false

ENABLE:
__ENABLE_ITEMS__

DISABLE_ERRORS_LINTERS:
__DISABLE_ERRORS_ITEMS__

FILTER_REGEX_EXCLUDE: '(node_modules|vendor|dist|build|\.venv|__pycache__|\.git|.*\.pdf$|\.lock$|package-lock\.json|pnpm-lock\.yaml|\.mega-linter\.yml)'

# Gate de typecheck (si el repo tiene TS). --include=dev es obligatorio:
# la imagen de MegaLinter corre con NODE_ENV=production y omitiría devDeps.
PRE_COMMANDS:
  - command: cd shared/hooks && npm ci --include=dev && npm run typecheck
    cwd: workspace
    continue_if_failed: false
