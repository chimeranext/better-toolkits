# Media Buyer — Multi-network OAuth2 env
# Cada red social pide sus propias credenciales OAuth2 independientes.
# Rationale igual a .heimdall.env: secretos por servicio, no expuestos al repo.
# SOLICITADO POR /toolkits-initial-setup (como Slack MCP --slack-client-id) — NO INVENTAR.

# LinkedIn Marketing API (linkedin-ads-cli / Bin-Huang)
# Solicita en setup: https://developer.linkedin.com/apps (Advertising API)
LINKEDIN_ADS_CLIENT_ID=REPLACE_WITH_LINKEDIN_ADS_CLIENT_ID
LINKEDIN_ADS_CLIENT_SECRET=REPLACE_WITH_LINKEDIN_ADS_CLIENT_SECRET
LINKEDIN_ADS_ACCESS_TOKEN=REPLACE_WITH_LINKEDIN_ADS_ACCESS_TOKEN

# Meta Marketing API
META_MARKETING_ACCESS_TOKEN=REPLACE_WITH_META_MARKETING_ACCESS_TOKEN

# TikTok Ads / Pixel / Attribution / Login
TIKTOK_ADS_ACCESS_TOKEN=REPLACE_WITH_TIKTOK_ADS_ACCESS_TOKEN
TIKTOK_PIXEL_ID=REPLACE_WITH_TIKTOK_PIXEL_ID

# Spotify Ads (Ad Specs / Pixel / Contextual / Agentic Tools)
SPOTIFY_ADS_ACCESS_TOKEN=REPLACE_WITH_SPOTIFY_ADS_ACCESS_TOKEN
SPOTIFY_PIXEL_ID=REPLACE_WITH_SPOTIFY_PIXEL_ID

# Google Drive — referencia cruzada con .google-workspace.env
GOOGLE_DRIVE_FOLDER_ID=REPLACE_WITH_GOOGLE_DRIVE_FOLDER_ID
