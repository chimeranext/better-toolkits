{
  "name": "@chimeranext/heimdall",
  "version": "0.1.0",
  "type": "module",
  "description": "Heimdall — standalone LLM PR-reviewer. Bypasses the gateway and POSTs directly to OpenAI-compatible providers (NVIDIA NIM / Kimi K2.6 by default).",
  "license": "MIT",
  "author": "Luis Andres Pena Castillo / ChimeraNext",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "heimdall-review": "./src/cli/review.ts"
  },
  "files": [
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "review:ci": "bun run src/cli/review-ci.ts",
    "review:diff": "bun run src/cli/review.ts diff",
    "review:pr": "bun run src/cli/review.ts pr",
    "dry-run:fixture": "bun run scripts/dry-run-fixture.ts",
    "dry-run:pr": "bun run scripts/dry-run-pr.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.47"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
