{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chimeranext.dev/schemas/policies.schema.json",
  "title": "ChimeraNext policies",
  "type": "object",
  "required": ["version", "merge"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "merge": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["merge", "squash", "rebase"]
        },
        "methods_forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["merge", "squash", "rebase"]
          }
        },
        "linear_history": {
          "type": "boolean"
        },
        "delete_branch_on_merge": {
          "type": "boolean"
        },
        "enforced_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
