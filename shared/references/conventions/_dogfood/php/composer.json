{
    "name": "conventions/dogfood-php",
    "description": "Minimal slice for laravel@0.1.0 gates (Pint + Pest) — run composer install before gates.",
    "type": "project",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Dogfood\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "pint:test": "pint --test"
    }
}
