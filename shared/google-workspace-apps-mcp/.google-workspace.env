# Google Workspace MCP — Taylor Wilson (@taylorwilsdon/google_workspace_mcp)
# Credenciales de conexión al MCP para acceso a Google Drive (videos de campaña).
# SOLICITADO POR /toolkits-initial-setup (como Slack MCP --slack-client-id) — NO INVENTAR.

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=REPLACE_WITH_GOOGLE_REFRESH_TOKEN
GOOGLE_FOLDER_ID=REPLACE_WITH_GOOGLE_FOLDER_ID
GOOGLE_API_SCOPE=https://www.googleapis.com/auth/drive.file
